# VENTANA PRINCIPAL
# ============================================================================
class MiniTiendaApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Mini Tienda Python Pro - 🛒")
        
        # Configurar pantalla completa PERO con barra de título
        self.pantalla_completa = False
        
        # En lugar de fullscreen, usar una ventana maximizada
        self.root.state('zoomed')  # Maximizada pero con barra de título
        
        # Obtener dimensiones de pantalla
        screen_width = self.root.winfo_screenwidth()
        screen_height = self.root.winfo_screenheight()
        
        # Configurar tamaño óptimo (95% de pantalla)
        window_width = int(screen_width * 0.95)
        window_height = int(screen_height * 0.90)
        
        # Centrar ventana
        x = (screen_width - window_width) // 2
        y = (screen_height - window_height) // 2
        
        self.root.geometry(f"{window_width}x{window_height}+{x}+{y}")
        
        # Botón para pantalla completa (F11)
        self.root.bind("<F11>", self.toggle_pantalla_completa)
        self.root.bind("<Escape>", self.salir_pantalla_completa)
        
        self.gestor_productos = GestorProductos()
        self.gestor_ventas = GestorVentas(self.gestor_productos)  # Pasar gestor_productos
        self.productos = self.gestor_productos.cargar_productos()
        
        # Variables de estilo
        self.colores = {
            'fondo': '#f0f0f0',
            'primario': '#2196F3',
            'secundario': '#4CAF50',
            'accent': '#FF9800',
            'peligro': '#F44336',
            'texto': '#000000'
        }
        
        self.setup_interfaz()
    
    def toggle_pantalla_completa(self, event=None):
        """Alternar entre pantalla completa y ventana normal"""
        self.pantalla_completa = not self.pantalla_completa
        if self.pantalla_completa:
            self.root.attributes('-fullscreen', True)
        else:
            self.root.attributes('-fullscreen', False)
            self.root.state('zoomed')  # Volver a maximizada
        self.actualizar_barra_estado()
    
    def salir_pantalla_completa(self, event=None):
        """Salir de pantalla completa con Escape"""
        if self.pantalla_completa:
            self.pantalla_completa = False
            self.root.attributes('-fullscreen', False)
            self.root.state('zoomed')
            self.actualizar_barra_estado()
    
    def actualizar_barra_estado(self):
        """Actualizar barra de estado con información de pantalla"""
        if hasattr(self, 'barra_estado'):
            modo = "FULLSCREEN" if self.pantalla_completa else "MAXIMIZADA"
            self.barra_estado.config(text=f"🟢 Sistema listo | Modo: {modo} | F11: Pantalla completa | ESC: Salir de pantalla completa")
    
