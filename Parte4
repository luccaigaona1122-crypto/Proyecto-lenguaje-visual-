        ventana.geometry("900x500")
        ventana.transient(self.root)
        
        frame = ttk.Frame(ventana, padding="20")
        frame.pack(fill=tk.BOTH, expand=True)
        
        ttk.Label(frame, text="📜 HISTORIAL DE VENTAS", 
                 font=('Arial', 16, 'bold')).pack(pady=10)
        
        # Treeview para ventas
        tree = ttk.Treeview(frame, columns=('id', 'fecha', 'items', 'total', 'archivo'), 
                           show='headings', height=15)
        
        column_config = [
            ('id', 'ID Factura', 150),
            ('fecha', 'Fecha y Hora', 150),
            ('items', 'Items', 80),
            ('total', 'Total (Gs)', 120),
            ('archivo', 'Archivo', 250)
        ]
        
        for col, heading, width in column_config:
            tree.heading(col, text=heading)
            tree.column(col, width=width)
        
        # Scrollbars
        vsb = ttk.Scrollbar(frame, orient=tk.VERTICAL, command=tree.yview)
        hsb = ttk.Scrollbar(frame, orient=tk.HORIZONTAL, command=tree.xview)
        tree.configure(yscrollcommand=vsb.set, xscrollcommand=hsb.set)
        
        tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, pady=10)
        vsb.pack(side=tk.RIGHT, fill=tk.Y)
        hsb.pack(side=tk.BOTTOM, fill=tk.X)
        
        # Cargar ventas
        self.cargar_ventas_en_tree(tree)
        
        # Frame para botones a la derecha (SIN Ver Detalle)
        botones_derecha = ttk.Frame(frame)
        botones_derecha.pack(side=tk.RIGHT, fill=tk.Y, padx=(20, 0))
        
        # Botones verticales (SIN Ver Detalle)
        ttk.Button(botones_derecha, text="📄 Ver Factura", 
                  command=lambda: self.ver_factura_completa(tree, ventana),
                  width=18).pack(pady=5)
        ttk.Button(botones_derecha, text="🗑️ Eliminar", 
                  command=lambda: self.eliminar_venta_seleccionada(tree),
                  width=18).pack(pady=5)
        ttk.Button(botones_derecha, text="🔄 Actualizar", 
                  command=lambda: self.cargar_ventas_en_tree(tree),
                  width=18).pack(pady=20)
        ttk.Button(botones_derecha, text="❌ Cerrar", 
                  command=ventana.destroy,
                  width=18).pack(pady=20)
    
    def cargar_ventas_en_tree(self, tree):
        """Cargar ventas en el treeview"""
        tree.delete(*tree.get_children())
        ventas = self.gestor_ventas.obtener_todas_ventas()
        for venta in ventas:
            fecha = datetime.fromisoformat(venta['fecha']).strftime("%d/%m/%Y %H:%M")
            tree.insert('', 'end', 
                       values=(venta['id'], fecha, 
                              len(venta['items']), 
                              f"{venta['total']:,}",
                              venta['archivo']))
    
    def ver_factura_completa(self, tree, parent_ventana):
        """Ver factura completa con botón cerrar"""
        seleccion = tree.selection()
        if not seleccion:
            messagebox.showwarning("Atención", "Seleccione una venta")
            return
        
        item = tree.item(seleccion[0])
        archivo = item['values'][4]
        
        if os.path.exists(archivo):
            try:
                with open(archivo, 'r', encoding='utf-8') as f:
                    contenido = f.read()
                
                # Mostrar contenido en nueva ventana
                ventana_factura = tk.Toplevel(parent_ventana)
                ventana_factura.title(f"🧾 Factura {item['values'][0]}")
                ventana_factura.geometry("600x500")
                ventana_factura.transient(parent_ventana)
                
                frame = ttk.Frame(ventana_factura, padding="10")
                frame.pack(fill=tk.BOTH, expand=True)
                
                # Área de texto con scroll
                texto = scrolledtext.ScrolledText(frame, wrap=tk.WORD, 
                                                 font=('Courier', 10))
                texto.pack(fill=tk.BOTH, expand=True, pady=(0, 10))
                
                texto.insert(1.0, contenido)
                texto.config(state='disabled')
                
                # Botón cerrar
                ttk.Button(frame, text="Cerrar", 
                          command=ventana_factura.destroy).pack()
                
            except Exception as e:
                messagebox.showerror("Error", f"No se pudo abrir el archivo: {e}")
        else:
            messagebox.showerror("Error", f"El archivo de factura no existe:\n{archivo}")
    
    def eliminar_venta_seleccionada(self, tree):
        """Eliminar venta seleccionada"""
        seleccion = tree.selection()
        if not seleccion:
            messagebox.showwarning("Atención", "Seleccione una venta")
            return
        
        item = tree.item(seleccion[0])
        venta_id = item['values'][0]
        archivo = item['values'][4]
        
        if messagebox.askyesno("Confirmar", 
                              f"¿Eliminar la venta {venta_id}?\n\nEsta acción no se puede deshacer."):
            # Eliminar archivo de factura
            if os.path.exists(archivo):
                try:
                    os.remove(archivo)
                except Exception as e:
                    print(f"Error eliminando archivo: {e}")
            
            # Eliminar de la lista de ventas
            ventas = self.gestor_ventas.obtener_todas_ventas()
            nuevas_ventas = [v for v in ventas if v['id'] != venta_id]
            
            # Guardar
            try:
                with open(self.gestor_ventas.archivo_ventas, 'w', encoding='utf-8') as f:
                    json.dump(nuevas_ventas, f, indent=4, ensure_ascii=False)
                
                # Actualizar treeview
                tree.delete(seleccion[0])
                messagebox.showinfo("✅ Éxito", "Venta eliminada")
                self.barra_estado.config(text=f"🗑️ Venta {venta_id} eliminada")
            except Exception as e:
                messagebox.showerror("❌ Error", f"No se pudo eliminar: {e}")
    
    def mostrar_estadisticas(self):
        """Mostrar estadísticas de ventas"""
        ventana = tk.Toplevel(self.root)
        ventana.title("📈 Estadísticas de Ventas")
        ventana.geometry("600x500")
        ventana.transient(self.root)
        
        frame = ttk.Frame(ventana, padding="20")
        frame.pack(fill=tk.BOTH, expand=True)
        
        ttk.Label(frame, text="📊 ESTADÍSTICAS", 
                 font=('Arial', 16, 'bold')).pack(pady=10)
        
        # Obtener estadísticas
        stats = self.gestor_ventas.obtener_estadisticas()
        
        # Crear frame para estadísticas
        stats_frame = ttk.Frame(frame)
        stats_frame.pack(fill=tk.BOTH, expand=True, pady=20)
        
        # Definir estadísticas a mostrar
        estadisticas = [
            ("💰 Total Ventas", f"{stats['total_ventas']} ventas"),
            ("💵 Monto Total", f"{stats['monto_total']:,} Gs"),
            ("📦 Promedio por Venta", f"{stats['promedio_venta']:,.0f} Gs"),
            ("📅 Ventas Hoy", f"{stats['ventas_hoy']} ventas"),
            ("🏆 Producto Más Vendido", stats['producto_mas_vendido']),
            ("📈 Mejor Día", stats['mejor_dia'])
        ]
        
        # Mostrar cada estadística en un frame con estilo
        for i, (titulo, valor) in enumerate(estadisticas):
            stat_frame = ttk.Frame(stats_frame, relief=tk.RIDGE, padding="10")
            stat_frame.pack(fill=tk.X, pady=5)
            
            ttk.Label(stat_frame, text=titulo, 
                     font=('Arial', 10)).pack(anchor=tk.W)
            ttk.Label(stat_frame, text=valor, 
                     font=('Arial', 12, 'bold'),
                     foreground=self.colores['primario']).pack(anchor=tk.W)
        
        # Botón para cerrar
        ttk.Button(frame, text="Cerrar", 
                  command=ventana.destroy).pack(pady=20)
    
    def exportar_datos(self):
        """Exportar datos a archivo de texto en la carpeta actual - CORREGIDO"""
        try:
            # Crear carpeta backups si no existe
            if not os.path.exists("backups"):
                os.makedirs("backups")
            
            fecha = datetime.now().strftime("%Y%m%d_%H%M%S")
            archivo = f"backups/datos_exportados_{fecha}.txt"
            
            with open(archivo, 'w', encoding='utf-8') as f:
                f.write("="*60 + "\n")
                f.write("EXPORTACIÓN DE DATOS - MINI TIENDA PYTHON PRO\n")
                f.write("="*60 + "\n\n")
                
                # Información del sistema
                f.write(f"Fecha de exportación: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}\n")
                
                # Productos
                productos = self.gestor_productos.cargar_productos()
                f.write(f"Total productos: {len(productos)}\n")
                
                # Ventas
                ventas = self.gestor_ventas.obtener_todas_ventas()
                f.write(f"Total ventas: {len(ventas)}\n\n")
                
                # Productos
                f.write("PRODUCTOS REGISTRADOS:\n")
                f.write("-"*60 + "\n")
                for codigo, producto in productos.items():
                    f.write(f"Código: {codigo}\n")
                    f.write(f"  Producto: {producto['nombre']}\n")
                    f.write(f"  Precio: {producto['precio']:,} Gs\n")
                    f.write(f"  Stock: {producto['stock']} unidades\n")
                    f.write(f"  Categoría: {producto.get('categoria', 'General')}\n")
                    f.write("-"*40 + "\n")
                
                f.write("\n" + "="*60 + "\n\n")
                
                # Ventas resumidas
                f.write("VENTAS REGISTRADAS:\n")
                f.write("-"*60 + "\n")
                for venta in ventas:
                    fecha_venta = datetime.fromisoformat(venta['fecha']).strftime('%d/%m/%Y %H:%M')
                    f.write(f"Factura: {venta['id']}\n")
                    f.write(f"  Fecha: {fecha_venta}\n")
                    f.write(f"  Total: {venta['total']:,} Gs\n")
                    f.write(f"  Items: {len(venta['items'])}\n")
                    f.write(f"  Archivo: {venta['archivo']}\n")
                    f.write("-"*40 + "\n")
            
            # Mostrar mensaje con la ruta exacta
            ruta_actual = os.getcwd()
            ruta_completa = os.path.join(ruta_actual, archivo)
            
            mensaje = f"✅ Datos exportados exitosamente\n\n"
            mensaje += f"📄 Archivo: datos_exportados_{fecha}.txt\n"
            mensaje += f"📂 Ubicación: {ruta_actual}\\backups\\\n\n"
            mensaje += "📋 Contenido exportado:\n"
            mensaje += f"  • {len(productos)} productos\n"
            mensaje += f"  • {len(ventas)} ventas"
            
            messagebox.showinfo("✅ Exportación Exitosa", mensaje)
            self.barra_estado.config(text=f"📤 Datos exportados a backups/datos_exportados_{fecha}.txt")
            
            # Intentar abrir la carpeta (Windows)
            if os.name == 'nt':  # Windows
                try:
                    os.startfile("backups")
                except:
                    pass
            
        except Exception as e:
            messagebox.showerror("❌ Error", f"No se pudo exportar: {str(e)}")

