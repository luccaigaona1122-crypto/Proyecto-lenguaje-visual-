    def editar_producto_seleccionado_gestion_corregido(self):
        """Editar producto seleccionado en gestión - CORREGIDO"""
        if not hasattr(self, 'tree_gestion') or not self.tree_gestion.selection():
            messagebox.showwarning("Atención", "Seleccione un producto para editar")
            return

        item = self.tree_gestion.item(self.tree_gestion.selection()[0])
        valores = item['values']
        
        if not valores or len(valores) < 1:
            messagebox.showerror("Error", "No se pudo obtener los datos del producto seleccionado")
            return
        
        # El código en el Treeview está como número entero (ej: 5), pero en la BD es string ("005")
        codigo_crudo = valores[0]
        
        # IMPORTANTE: Convertir el número a string de 3 dígitos
        # Si el código es un número, formatearlo a 3 dígitos con ceros a la izquierda
        try:
            # Si es número (int, float), convertirlo a string con 3 dígitos
            if isinstance(codigo_crudo, (int, float)):
                codigo = f"{int(codigo_crudo):03d}"  # Esto convierte 5 a "005"
            else:
                # Si ya es string, usar directamente
                codigo = str(codigo_crudo).strip()
        except:
            # Si falla, usar el valor crudo como string
            codigo = str(codigo_crudo).strip()

        # Obtener datos actuales del producto
        productos = self.gestor_productos.cargar_productos()
        
        # Verificar si el código existe en la base de datos
        if codigo not in productos:
            # Intentar otras formas de búsqueda
            # 1. Buscar sin ceros a la izquierda
            codigo_sin_ceros = str(int(codigo_crudo)) if isinstance(codigo_crudo, (int, float)) else codigo.lstrip('0')
            
            # 2. Buscar por nombre del producto
            nombre_producto = valores[1] if len(valores) > 1 else ""
            
            # Buscar en la base de datos
            encontrado = False
            for codigo_db, producto_db in productos.items():
                # Verificar si coincide por código (con o sin ceros)
                if codigo == codigo_db or codigo_sin_ceros == codigo_db.lstrip('0'):
                    codigo = codigo_db  # Usar el código real de la BD
                    encontrado = True
                    break
                # Verificar si coincide por nombre
                elif nombre_producto and producto_db['nombre'] == nombre_producto:
                    codigo = codigo_db  # Usar el código real de la BD
                    encontrado = True
                    break
            
            if not encontrado:
                messagebox.showerror("Error", 
                    f"Producto no encontrado.\n"
                    f"Código del treeview: {codigo_crudo}\n"
                    f"Código formateado: {codigo}\n"
                    f"Nombre: {nombre_producto}\n\n"
                    f"Productos disponibles:\n" + 
                    "\n".join([f"  {k}: {v['nombre']}" for k, v in productos.items()]))
                return

        # Ahora tenemos el código correcto
        producto = productos[codigo]

        # Crear formulario de edición
        formulario = tk.Toplevel(self.root)
        formulario.title(f"✏️ Editar Producto: {producto['nombre']}")
        formulario.geometry("400x400")
        formulario.transient(self.root)

        frame = ttk.Frame(formulario, padding="20")
        frame.pack(fill=tk.BOTH, expand=True)

        ttk.Label(frame, text=f"EDITAR PRODUCTO: {codigo}", 
                font=('Arial', 14, 'bold')).pack(pady=10)

        # Campos
        campos_frame = ttk.Frame(frame)
        campos_frame.pack(fill=tk.BOTH, expand=True, pady=10)

        # Código (solo lectura)
