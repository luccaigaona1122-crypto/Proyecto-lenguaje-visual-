# MÓDULO DE PRODUCTOS
# ============================================================================
class GestorProductos:
    def __init__(self):
        self.archivo_productos = "data/productos.json"
        self.cargar_productos()
        
    def cargar_productos(self):
        """Cargar productos desde archivo JSON"""
        if not os.path.exists("data"):
            os.makedirs("data")
            
        if os.path.exists(self.archivo_productos):
            with open(self.archivo_productos, 'r', encoding='utf-8') as f:
                return json.load(f)
        else:
            # Productos por defecto
            productos_default = {
                "001": {"nombre": "Pan", "precio": 2500, "stock": 50, "categoria": "Panadería"},
                "002": {"nombre": "Leche", "precio": 5000, "stock": 30, "categoria": "Lácteos"},
                "003": {"nombre": "Queso", "precio": 12000, "stock": 20, "categoria": "Lácteos"},
                "004": {"nombre": "Gaseosa", "precio": 7000, "stock": 40, "categoria": "Bebidas"},
                "005": {"nombre": "Yerba", "precio": 10000, "stock": 25, "categoria": "Almacén"},
                "006": {"nombre": "Arroz", "precio": 8000, "stock": 35, "categoria": "Almacén"},
                "007": {"nombre": "Fideos", "precio": 4500, "stock": 45, "categoria": "Almacén"},
                "008": {"nombre": "Aceite", "precio": 15000, "stock": 15, "categoria": "Almacén"},
                "009": {"nombre": "Azúcar", "precio": 6000, "stock": 40, "categoria": "Almacén"},
                "010": {"nombre": "Café", "precio": 18000, "stock": 20, "categoria": "Almacén"}
            }
            self.guardar_productos(productos_default)
            return productos_default
    
    def guardar_productos(self, productos):
        """Guardar productos en archivo JSON"""
        with open(self.archivo_productos, 'w', encoding='utf-8') as f:
            json.dump(productos, f, indent=4, ensure_ascii=False)
    
    def agregar_producto(self, codigo, nombre, precio, stock, categoria="General"):
        """Agregar nuevo producto"""
        productos = self.cargar_productos()
        
        if codigo in productos:
            return False, "El código ya existe"
        
        productos[codigo] = {
            "nombre": nombre,
            "precio": precio,
            "stock": stock,
            "categoria": categoria
        }
        
        self.guardar_productos(productos)
        return True, "Producto agregado exitosamente"
    
    def editar_producto(self, codigo, nombre, precio, stock, categoria="General"):
        """Editar producto existente"""
        productos = self.cargar_productos()
        
        if codigo not in productos:
            return False, "El código no existe"
        
        productos[codigo] = {
            "nombre": nombre,
            "precio": precio,
            "stock": stock,
            "categoria": categoria
        }
        
        self.guardar_productos(productos)
        return True, "Producto actualizado exitosamente"
    
    def eliminar_producto(self, codigo):
        """Eliminar producto"""
        productos = self.cargar_productos()
        
        if codigo not in productos:
            return False, "El código no existe"
        
        del productos[codigo]
        self.guardar_productos(productos)
        return True, "Producto eliminado exitosamente"
    
    def buscar_producto(self, criterio, valor):
        """Buscar productos por criterio"""
        productos = self.cargar_productos()
        resultados = {}
        
        for codigo, producto in productos.items():
            if criterio == "codigo" and valor.lower() in codigo.lower():
                resultados[codigo] = producto
            elif criterio == "nombre" and valor.lower() in producto["nombre"].lower():
                resultados[codigo] = producto
            elif criterio == "categoria" and valor.lower() in producto["categoria"].lower():
                resultados[codigo] = producto
        
        return resultados
    
    def actualizar_stock(self, nombre_producto, cantidad_vendida):
        """Actualizar stock después de una venta"""
        productos = self.cargar_productos()
        
        for codigo, producto in productos.items():
            if producto['nombre'] == nombre_producto:
                nuevo_stock = producto['stock'] - cantidad_vendida
                if nuevo_stock < 0:
                    nuevo_stock = 0
                producto['stock'] = nuevo_stock
                self.guardar_productos(productos)
                return True
        
        return False

# ============================================================================
# MÓDULO DE VENTAS
# ============================================================================
class GestorVentas:
    def __init__(self, gestor_productos):
        self.gestor_productos = gestor_productos
        self.carpeta_facturas = "facturas"
        self.archivo_ventas = "data/ventas.json"
        
        # Crear carpetas necesarias
        if not os.path.exists(self.carpeta_facturas):
            os.makedirs(self.carpeta_facturas)
        if not os.path.exists("data"):
            os.makedirs("data")
    
    def generar_factura(self, items):
        """Generar factura y registrar venta - ACTUALIZA STOCK"""
        try:
            # Calcular total
            total = sum(item['total'] for item in items)
            
            # Generar ID único
            factura_id = datetime.now().strftime("%Y%m%d_%H%M%S")
            
            # Crear nombre de archivo
            archivo_factura = f"{self.carpeta_facturas}/factura_{factura_id}.txt"
            
            # Generar contenido de la factura
            contenido = self._generar_contenido_factura(factura_id, items, total)
            
            # Guardar factura en archivo
            with open(archivo_factura, 'w', encoding='utf-8') as f:
                f.write(contenido)
            
            # ACTUALIZAR STOCK de cada producto vendido
            for item in items:
                self.gestor_productos.actualizar_stock(
                    item['producto'], 
                    item['cantidad']
                )
            
            # Registrar venta en JSON
            self._registrar_venta(factura_id, items, total, archivo_factura)
            
            return True
        except Exception as e:
            print(f"Error generando factura: {e}")
            return False
    
    def _generar_contenido_factura(self, factura_id, items, total):
        """Generar contenido de la factura"""
        contenido = "=" * 50 + "\n"
        contenido += "MINI TIENDA PYTHON PRO\n"
        contenido += "=" * 50 + "\n"
        contenido += f"Factura N°: {factura_id}\n"
        contenido += f"Fecha: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}\n"
        contenido += "-" * 50 + "\n"
        contenido += "CANT  DESCRIPCIÓN          PRECIO UNIT.     TOTAL\n"
        contenido += "-" * 50 + "\n"
        
        for item in items:
            nombre = item['producto']
            cantidad = item['cantidad']
            precio_unit = item['precio_unitario']
            total_item = item['total']
            
            contenido += f"{cantidad:4d}  {nombre:20s} {precio_unit:10,} Gs  {total_item:10,} Gs\n"
        
        contenido += "-" * 50 + "\n"
        contenido += f"{'TOTAL A PAGAR:':36s} {total:10,} Gs\n"
        contenido += "=" * 50 + "\n"
        contenido += "¡Gracias por tu compra! Vuelve pronto\n"
        
        return contenido
    
    def _registrar_venta(self, factura_id, items, total, archivo_factura):
        """Registrar venta en archivo JSON"""
        venta = {
            "id": factura_id,
            "fecha": datetime.now().isoformat(),
            "items": items,
            "total": total,
            "archivo": archivo_factura
        }
        
        # Cargar ventas existentes
        ventas = self.obtener_todas_ventas()
        ventas.append(venta)
        
        # Guardar en archivo
        with open(self.archivo_ventas, 'w', encoding='utf-8') as f:
            json.dump(ventas, f, indent=4, ensure_ascii=False)
    
    def obtener_todas_ventas(self):
        """Obtener todas las ventas registradas"""
        if os.path.exists(self.archivo_ventas):
            with open(self.archivo_ventas, 'r', encoding='utf-8') as f:
                return json.load(f)
        return []
    
    def obtener_ventas_por_fecha(self, fecha_inicio, fecha_fin):
        """Obtener ventas en un rango de fechas"""
        ventas = self.obtener_todas_ventas()
        resultado = []
        
        for venta in ventas:
            fecha_venta = datetime.fromisoformat(venta['fecha']).date()
            if fecha_inicio <= fecha_venta <= fecha_fin:
                resultado.append(venta)
        
        return resultado
    
    def obtener_estadisticas(self):
        """Obtener estadísticas de ventas"""
        ventas = self.obtener_todas_ventas()
        
        if not ventas:
            return {
                "total_ventas": 0,
                "monto_total": 0,
                "promedio_venta": 0,
                "ventas_hoy": 0,
                "producto_mas_vendido": "No hay datos",
                "mejor_dia": "No hay datos",
                "categoria_popular": "No hay datos"
            }
        
        # Estadísticas básicas
        total_ventas = len(ventas)
        monto_total = sum(venta['total'] for venta in ventas)
        promedio_venta = monto_total / total_ventas if total_ventas > 0 else 0
        
        # Ventas de hoy
        hoy = datetime.now().date()
        ventas_hoy = sum(1 for venta in ventas 
                        if datetime.fromisoformat(venta['fecha']).date() == hoy)
        
        # Producto más vendido
        productos_vendidos = {}
        for venta in ventas:
            for item in venta['items']:
                producto = item['producto']
                cantidad = item['cantidad']
                productos_vendidos[producto] = productos_vendidos.get(producto, 0) + cantidad
        
        producto_mas_vendido = max(productos_vendidos.items(), 
                                  key=lambda x: x[1], 
                                  default=("No hay datos", 0))[0]
        
        # Mejor día (por monto)
        ventas_por_dia = {}
        for venta in ventas:
            fecha = datetime.fromisoformat(venta['fecha']).strftime("%Y-%m-%d")
            ventas_por_dia[fecha] = ventas_por_dia.get(fecha, 0) + venta['total']
        
        mejor_dia = max(ventas_por_dia.items(), 
                       key=lambda x: x[1], 
                       default=("No hay datos", 0))[0]
        
        return {
            "total_ventas": total_ventas,
            "monto_total": monto_total,
            "promedio_venta": promedio_venta,
            "ventas_hoy": ventas_hoy,
            "producto_mas_vendido": producto_mas_vendido,
            "mejor_dia": mejor_dia
        }

