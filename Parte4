    def actualizar_lista_productos(self):
        """Actualizar lista de productos disponibles"""
        self.tree_productos.delete(*self.tree_productos.get_children())
        self.productos = self.gestor_productos.cargar_productos()  # ACTUALIZAR DATOS
        
        for codigo, producto in self.productos.items():
            self.tree_productos.insert('', 'end', 
                                    values=(codigo,  # Ya es string como "005"
                                            producto['nombre'], 
                                            f"{producto['precio']:,}",
                                            producto['stock'],
                                            producto.get('categoria', 'General')))
        
        # Ahora sí podemos usar self.barra_estado porque ya está definido
        self.barra_estado.config(text="✅ Lista de productos actualizada")
    
    def mostrar_todos_productos(self):
        """Mostrar todos los productos (limpiar búsqueda)"""
        self.busqueda_entry.delete(0, tk.END)
        self.actualizar_lista_productos()
    
    def buscar_productos(self):
        """Buscar productos según criterio"""
        criterio = self.busqueda_entry.get().strip()
        if not criterio:
            self.actualizar_lista_productos()
            return
        
        resultados = self.gestor_productos.buscar_producto("nombre", criterio)
        self.tree_productos.delete(*self.tree_productos.get_children())
        
        for codigo, producto in resultados.items():
            self.tree_productos.insert('', 'end', 
                                      values=(codigo, 
                                             producto['nombre'], 
                                             f"{producto['precio']:,}",
                                             producto['stock'],
                                             producto.get('categoria', 'General')))
        self.barra_estado.config(text=f"🔍 Mostrando {len(resultados)} resultados para '{criterio}'")
    
    def agregar_al_carrito(self):
        """Agregar producto seleccionado al carrito"""
        seleccion = self.tree_productos.selection()
        if not seleccion:
            messagebox.showwarning("Atención", "Seleccione un producto de la lista")
            return
        
        # Obtener producto seleccionado
        item = self.tree_productos.item(seleccion[0])
        codigo, nombre, precio_str, stock_str, _ = item['values']
        
        # Convertir precio
        precio = int(precio_str.replace(',', ''))
        stock = int(stock_str)
        
        # Obtener cantidad
        try:
            cantidad = int(self.cantidad_var.get())
            if cantidad <= 0:
                cantidad = 1
        except ValueError:
            cantidad = 1
        
        # Verificar stock
        if cantidad > stock:
            messagebox.showwarning("Stock insuficiente", 
                                  f"Solo hay {stock} unidades disponibles")
            return
        
        # Buscar si ya está en el carrito
        for item_id in self.tree_carrito.get_children():
            valores = self.tree_carrito.item(item_id)['values']
            if valores[1] == nombre:
                # Actualizar cantidad
                nueva_cantidad = valores[0] + cantidad
                nuevo_total = nueva_cantidad * precio
                self.tree_carrito.item(item_id, 
                                      values=(nueva_cantidad, nombre, 
                                             f"{precio:,}", f"{nuevo_total:,}"))
                self.actualizar_total()
                self.barra_estado.config(text=f"✅ Producto '{nombre}' actualizado en carrito")
                return
        
        # Agregar nuevo item al carrito
        total = cantidad * precio
        self.tree_carrito.insert('', 'end', 
                                values=(cantidad, nombre, 
                                       f"{precio:,}", f"{total:,}"))
        
        self.actualizar_total()
        self.barra_estado.config(text=f"✅ Producto '{nombre}' agregado al carrito")
    
    def quitar_del_carrito(self):
        """Quitar producto seleccionado del carrito"""
        seleccion = self.tree_carrito.selection()
        if not seleccion:
            messagebox.showwarning("Atención", "Seleccione un producto del carrito")
            return
        
        item = self.tree_carrito.item(seleccion[0])
        nombre = item['values'][1]
        
        self.tree_carrito.delete(seleccion[0])
        self.actualizar_total()
        self.barra_estado.config(text=f"🗑️ Producto '{nombre}' eliminado del carrito")
    
    def limpiar_carrito(self):
        """Vaciar completamente el carrito"""
        if not self.tree_carrito.get_children():
            return
        
        if messagebox.askyesno("Confirmar", "¿Vaciar todo el carrito?"):
            self.tree_carrito.delete(*self.tree_carrito.get_children())
            self.actualizar_total()
            self.barra_estado.config(text="🗑️ Carrito vaciado")
    
    def actualizar_total(self):
        """Calcular y mostrar el total del carrito"""
        total = 0
        for item in self.tree_carrito.get_children():
            valores = self.tree_carrito.item(item)['values']
            total_item = int(valores[3].replace(',', ''))
            total += total_item
        
        self.total_label.config(text=f"TOTAL: {total:,} Gs")
    
    def finalizar_compra(self):
        """Procesar la compra y generar factura"""
        if not self.tree_carrito.get_children():
            messagebox.showwarning("Atención", "El carrito está vacío")
            return
        
        # Crear ventana de confirmación
        ventana_confirmacion = tk.Toplevel(self.root)
        ventana_confirmacion.title("Confirmar Compra")
        ventana_confirmacion.geometry("500x400")
        ventana_confirmacion.configure(bg='white')
        ventana_confirmacion.transient(self.root)
        ventana_confirmacion.grab_set()
        
        # Frame principal
        frame = ttk.Frame(ventana_confirmacion, padding="20")
        frame.pack(fill=tk.BOTH, expand=True)
        
        # Título
        ttk.Label(frame, text="💰 FINALIZAR COMPRA", 
                 font=('Arial', 16, 'bold'),
                 foreground=self.colores['primario']).pack(pady=10)
        
        # Mostrar resumen en un Text widget
        texto_resumen = scrolledtext.ScrolledText(frame, height=12, width=50)
        texto_resumen.pack(pady=10)
        
        total = 0
        resumen = "🧾 RESUMEN DE COMPRA:\n"
        resumen += "═" * 45 + "\n\n"
        
        for item in self.tree_carrito.get_children():
            valores = self.tree_carrito.item(item)['values']
            cantidad, nombre, precio_unit, total_item = valores
            resumen += f"  {cantidad}× {nombre}\n"
            resumen += f"     {precio_unit} = {total_item}\n\n"
            total += int(total_item.replace(',', ''))
        
        resumen += "═" * 45 + "\n"
        resumen += f"  TOTAL: {total:,} Gs\n"
        resumen += "═" * 45 + "\n"
        
        texto_resumen.insert(1.0, resumen)
        texto_resumen.config(state='disabled')
        
        # Botones
        btn_frame = ttk.Frame(frame)
        btn_frame.pack(pady=20)
        
        ttk.Button(btn_frame, text="❌ Cancelar", 
                  command=ventana_confirmacion.destroy).pack(side=tk.LEFT, padx=10)
        ttk.Button(btn_frame, text="✅ Confirmar Pago", 
                  command=lambda: self.generar_factura_y_limpiar(ventana_confirmacion)).pack(side=tk.LEFT, padx=10)
    
    def generar_factura_y_limpiar(self, ventana):
        """Generar factura y limpiar carrito - AHORA ACTUALIZA STOCK"""
        # Obtener items del carrito
        items_venta = []
        for item in self.tree_carrito.get_children():
            valores = self.tree_carrito.item(item)['values']
            nombre = valores[1]
            precio_unit = int(valores[2].replace(',', ''))
            cantidad = valores[0]
            total_item = int(valores[3].replace(',', ''))
            
            items_venta.append({
                'producto': nombre,
                'precio_unitario': precio_unit,
                'cantidad': cantidad,
                'total': total_item
            })
        
        # Generar factura (AHORA ACTUALIZA STOCK AUTOMÁTICAMENTE)
        exito = self.gestor_ventas.generar_factura(items_venta)
        
        if exito:
            # Limpiar carrito
            self.tree_carrito.delete(*self.tree_carrito.get_children())
            self.actualizar_total()
            
            # Cerrar ventana de confirmación
            ventana.destroy()
            
            # Actualizar lista de productos para mostrar nuevo stock
            self.actualizar_lista_productos()
            
            # Mostrar mensaje de éxito
            messagebox.showinfo("🎉 ¡Compra Exitosa!", 
                              "✅ Factura generada correctamente\n" +
                              "✅ Stock actualizado\n" +
                              "📄 La factura se guardó en la carpeta 'facturas/'")
            self.barra_estado.config(text="✅ Venta registrada y stock actualizado")
        else:
            messagebox.showerror("❌ Error", 
                               "No se pudo generar la factura")
    
