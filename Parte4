        codigo_label = ttk.Label(campos_frame, text=codigo, font=('Arial', 10, 'bold'))
        codigo_label.grid(row=0, column=1, pady=5, padx=5, sticky=tk.W)

        # Nombre
        ttk.Label(campos_frame, text="Nombre:").grid(row=1, column=0, sticky=tk.W, pady=5)
        nombre_entry = ttk.Entry(campos_frame, width=25)
        nombre_entry.insert(0, producto['nombre'])
